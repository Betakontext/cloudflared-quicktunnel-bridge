
# .env.files
# Separate output-file tunnel without ComfyUI lifecycle control.

FTPS_ENABLE=true
FTPS_HOST=
FTPS_USER=
FTPS_PASS=
FTPS_DIR=yourserverurl/bridge/files


COMFY_URL=http://127.0.0.1:8800

HTTP_HOST=127.0.0.1
HTTP_PORT=8800
HTTP_CORS=false

CLOUDFLARED=
OUT_DIR=./bridge_output_files
EDGE_PROTOCOL=http2

FILES_ENABLE=true
FILES_ROOT=C:\Users\Administrator\Documents\Arbeiten\0000_DEV\ComfyUI\output
FILES_INDEX=true
FILES_RANGE=true

# Check the local file server, independently of ComfyUI.
HEALTH_TARGET=http://127.0.0.1:8800/
HEALTH_INTERVAL=15
HEALTH_THRESHOLD=3

# Root restart.flag restarts only the files tunnel.
FTPS_RESTART_FLAG=restart.flag
FTPS_TUNNEL_STOP_FLAG=stop.flag
FTPS_CHECK_INTERVAL=30
FTPS_FLAG_ACTION=cloudflared

# Disable local ComfyUI actions and filesystem watching.
COMFY_FLAG_WATCH_DIR=
COMFY_RESTART_CMD=
COMFY_STOP_CMD=

