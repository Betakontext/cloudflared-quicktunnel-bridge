
# .env
# Separate output-file tunnel without ComfyUI lifecycle control.

FTPS_ENABLE=true
FTPS_HOST=
FTPS_USER=
FTPS_PASS=
FTPS_DIR=

COMFY_URL=http://127.0.0.1:8188

HTTP_HOST=127.0.0.1
HTTP_PORT=8799
HTTP_CORS=false

CLOUDFLARED=
OUT_DIR=./bridge_output
EDGE_PROTOCOL=http2

# File serving is handled by the separate files instance.
FILES_ENABLE=false
FILES_INDEX=false
FILES_RANGE=true

# Leave disabled to avoid tunnel restarts during intentional ComfyUI stops.
HEALTH_TARGET=
HEALTH_INTERVAL=15
HEALTH_THRESHOLD=3

# Root restart.flag restarts this cloudflared tunnel.
# Flags in the comfy subdirectory control ComfyUI.
FTPS_RESTART_FLAG=restart.flag
FTPS_STOP_FLAG_NAME=stop.flag
FTPS_TUNNEL_STOP_FLAG=stop.flag
FTPS_CHECK_INTERVAL=30
FTPS_FLAG_ACTION=both
FTPS_COMFY_SUBDIR=comfy

# Resolve COMFY_ROOT relative to the lifecycle script directory.
COMFY_ROOT=../ComfyUI

COMFY_RESTART_CMD=powershell.exe -NoProfile -File ".\restart_comfyui.ps1" -ForceStop -LowVRAM
COMFY_STOP_CMD=powershell.exe -NoProfile -File ".\stop_comfyui.ps1" -ForceStop

# Disable the independent local filesystem flag watcher.
COMFY_FLAG_WATCH_DIR=
